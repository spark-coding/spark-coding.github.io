doctype html
html(lang='en')

    - var base = ''

    mixin buildCard(icon, title, platform, text)
        .col-md-6.col-lg-4
            .build-card.h-100
                .build-icon
                    i.bi(class='bi-' + icon)
                h3.h5.mb-1= title
                span.badge.build-platform.mb-2= platform
                p.text-muted.mb-0= text

    mixin termCard(stage, who, tool, items, build)
        .col-md-6.col-xl-3
            .term-card.h-100
                .term-stage= stage
                h3.h5.mb-1= who
                p.small.text-primary.fw-bold.mb-3= tool
                p.small.text-muted.mb-2 By the end of the term they can:
                ul.small.mb-3
                    each item in items
                        li= item
                p.small.mb-0
                    strong Builds like: 
                    | #{build}

    mixin review(name, text)
        .col-lg-4
            figure.review-card.h-100
                .review-stars.mb-2(aria-label='5 out of 5 stars')
                    i.bi.bi-star-fill
                    i.bi.bi-star-fill
                    i.bi.bi-star-fill
                    i.bi.bi-star-fill
                    i.bi.bi-star-fill
                blockquote.mb-3
                    p.mb-0= text
                figcaption.small.text-muted
                    | #{name} · 
                    i.bi.bi-google.me-1
                    | Google review

    mixin faq(id, question)
        .accordion-item
            h3.accordion-header(id='faq-h-' + id)
                button.accordion-button.collapsed(type='button', data-bs-toggle='collapse', data-bs-target='#faq-' + id, aria-expanded='false', aria-controls='faq-' + id)= question
            .accordion-collapse.collapse(id='faq-' + id, aria-labelledby='faq-h-' + id, data-bs-parent='#faqAccordion')
                .accordion-body
                    block

